# GTMC-NPI website environment configuration
# Copy this file to .env ONE LEVEL ABOVE public_html (e.g. /home/USER/.env)
# and fill in the real values. Never commit the real .env.

# Database (MySQL / MariaDB)
DB_HOST=localhost
DB_NAME=r145004gtmc_npi
DB_USER=your_db_user_here  # cPanel: prefixed with the account prefix
DB_PASS=your_secure_password_here

# Public URL (no trailing slash)
SITE_URL=https://gtmc-npi.eu

# SMTP (cPanel / mail provider)
SMTP_HOST=mail.gtmc-npi.eu
SMTP_PORT=465
SMTP_USER=info@gtmc-npi.eu
SMTP_PASS=your_smtp_password_here

# Support / staff notifications
SUPPORT_EMAIL=help@gtmc-npi.eu
STAFF_EMAIL=info@gtmc-npi.eu

# License server (RSA-signed tokens for the GTMC-NPI app)
# Path to the PRIVATE key, OUTSIDE public_html. To stay compatible with the
# installed apps, upload the existing bridge key here (see DEPLOY.md).
LICENSE_RSA_PRIVATE_KEY_PATH=/home/USER/keys/license_private.pem
# Alternative (not recommended): the PEM inline with \n line breaks
# LICENSE_RSA_PRIVATE_KEY=
LICENSE_DEFAULT_GRACE_DAYS=30

# Secret for HMAC-signed helpers (long random string)
LICENSE_MASTER_KEY=change_this_to_a_long_random_secret_key

# Stripe (optional, used by api/payments/)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# PayPal (optional)
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_WEBHOOK_ID=...

# Site / App
APP_ENV=production
APP_DEBUG=false
